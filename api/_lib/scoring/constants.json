  "win_chance": {
    "formula": "Phi((P_yours - P_opp) / sqrt(Var_yours + Var_opp - 2*Cov)); Var = sum sigma_i^2 + 2*sum_{i<j} rho_ij sigma_i sigma_j; Cov = sum_{i in yours, j in opp} rho_ij sigma_i sigma_j",
