{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "crons": [
    {
      "path": "/api/player-news",
      "schedule": "22 14 * * 1-6"
    },
    {
      "path": "/api/player-news",
      "schedule": "15 23 * * 1-6"
    },
    {
      "path": "/api/player-news",
      "schedule": "0 16 * * 0"
    },
    {
      "path": "/api/player-news",
      "schedule": "5 19 * * 0"
    },
    {
      "path": "/api/player-news",
      "schedule": "20 23 * * 0"
    },
    {
      "path": "/api/cron/jobs?job=refresh-fantasycalc",
      "schedule": "30 11 * * *"
    },
    {
      "path": "/api/cron/jobs?job=rebuild-dashboard",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/jobs?job=rebuild-dashboard",
      "schedule": "0 23 * * 0"
    }
  ],
  "framework": null,
  "functions": {
    "api/draft-center.ts": {
      "maxDuration": 60
    },
    "api/trades/history.ts": {
      "maxDuration": 60
    },
    "api/dashboard.ts": {
      "maxDuration": 60
    },
    "api/cron/jobs.ts": {
      "maxDuration": 60
    },
    "api/ingest/[target].ts": {
      "maxDuration": 60
    }
  },
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "destination": "/index.html",
      "source": "/((?!api/).*)"
    },
    {
      "source": "/api/dashboard/section",
      "destination": "/api/dashboard?__section=1"
    }
  ]
}