{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "framework": null,
  "functions": {
    "api/draft-center.ts": {
      "maxDuration": 60
    },
    "api/data/[kind].ts": {
      "maxDuration": 60
    },
    "api/dashboard.ts": {
      "maxDuration": 60
    },
    "api/cron/jobs.ts": {
      "maxDuration": 60
    },
    "api/ingest/[target].ts": {
      "maxDuration": 60
    },
    "api/player-news.ts": {
      "maxDuration": 60
    },
    "api/chat.ts": {
      "maxDuration": 60
    }
  },
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/box-score",
      "destination": "/api/data/box-score"
    },
    {
      "source": "/api/pfn-tables",
      "destination": "/api/data/pfn-tables"
    },
    {
      "source": "/api/value-history",
      "destination": "/api/data/value-history"
    },
    {
      "source": "/api/trades/history",
      "destination": "/api/data/trades-history"
    },
    {
      "source": "/api/dashboard/section",
      "destination": "/api/dashboard?__section=1"
    },
    {
      "destination": "/index.html",
      "source": "/((?!api/).*)"
    }
  ]
}
