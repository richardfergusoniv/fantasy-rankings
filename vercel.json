{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "framework": null,
  "functions": {
    "api/draft-center.ts": {
      "maxDuration": 60
    },
    "api/trades/history.ts": {
      "maxDuration": 60
    },
    "api/dashboard.ts": {
      "maxDuration": 60
    },
    "api/cron/jobs.ts": {
      "maxDuration": 60
    },
    "api/ingest/[target].ts": {
      "maxDuration": 60
    },
    "api/player-news.ts": {
      "maxDuration": 60
    }
  },
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "destination": "/index.html",
      "source": "/((?!api/).*)"
    },
    {
      "source": "/api/dashboard/section",
      "destination": "/api/dashboard?__section=1"
    }
  ]
}
