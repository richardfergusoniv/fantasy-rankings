# Copy to .env (local dev) or set in Vercel dashboard → Settings → Environment Variables.
# NEVER commit .env to git.

# Supabase Postgres connection string (use the pooler URL, port 6543, for serverless).
# Found in Supabase dashboard → Project Settings → Database.
DATABASE_URL=postgresql://postgres:[PASSWORD]@[PROJECT].pooler.supabase.com:6543/postgres

# Supabase project URL and anon key (Project Settings → API).
# Canonical names. The server reads these first.
SUPABASE_URL=https://[PROJECT].supabase.co
SUPABASE_ANON_KEY=[ANON_KEY]
# Same two values for the Vite browser build. Vite only exposes VITE_ vars.
# If these are unset, frontend/vite.config.ts copies SUPABASE_URL /
# SUPABASE_ANON_KEY, then NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY.
VITE_SUPABASE_URL=https://[PROJECT].supabase.co
VITE_SUPABASE_ANON_KEY=[ANON_KEY]

# Shared secret for cron/webhook endpoints.
# Vercel Cron sends: Authorization: Bearer <CRON_SECRET>
# The props pipeline sends the same header on ingest webhooks.
CRON_SECRET=[GENERATE_RANDOM_32_CHARS]

# Comma-separated Supabase user IDs with admin access (replaces ctx.viewer.isOwner).
ADMIN_USER_IDS=[YOUR_SUPABASE_USER_ID]

# Sleeper user id used only by scheduled jobs that have no signed-in user:
# the dashboard rebuild and the props pipeline league list. Player news,
# draft center, trade history, and interactive dashboards use the signed-in
# user's Sleeper connection and that user's own leagues.
# Set this in the Vercel project environment and as a GitHub Actions
# repository variable (Settings → Secrets and variables → Actions → Variables).
# It is an account id, not a credential. Do not commit a real value.
OWNER_SLEEPER_USER_ID=
